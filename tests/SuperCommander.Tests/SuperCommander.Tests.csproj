<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A plain console runner, deliberately not a test framework: the app itself has
    no package references and neither does this. `dotnet run` prints one line per
    assertion and exits non-zero on the first failure count above zero.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RootNamespace>SuperCommander.Tests</RootNamespace>
    <AssemblyName>SuperCommander.Tests</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SuperCommander\SuperCommander.csproj" />
  </ItemGroup>

</Project>
