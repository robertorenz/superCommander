<UserControl x:Class="SuperCommander.Views.FilePaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SuperCommander.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:FilePaneViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Focusable="False">

    <Border x:Name="PaneBorder" BorderThickness="1" CornerRadius="3"
            BorderBrush="{DynamicResource App.Border}"
            Background="{DynamicResource App.Surface}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ===================== Drive bar ===================== -->
            <Border x:Name="DriveBar" Grid.Row="0" Padding="5,4"
                    Background="{DynamicResource App.SurfaceAlt}"
                    BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,0,1">
                <Grid>
                    <ItemsControl ItemsSource="{Binding Drives}" HorizontalAlignment="Left">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SC.DriveButton}"
                                        Content="{Binding Letter}"
                                        ToolTip="{Binding Tooltip}"
                                        Tag="{Binding Root}"
                                        Click="OnDriveClick" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                               Style="{StaticResource SC.Label.Muted}" FontSize="11"
                               Text="{Binding FreeSpaceText}" Margin="8,0,2,0" />
                </Grid>
            </Border>

            <!-- ======================= Tabs ======================== -->
            <Border x:Name="TabBar" Grid.Row="1" Background="{DynamicResource Tab.Background}"
                    BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,0,1">
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Tabs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="TabHost" Margin="0,0,1,0" BorderThickness="0,0,0,2"
                                        BorderBrush="Transparent" Background="Transparent"
                                        MouseLeftButtonUp="OnTabClick"
                                        MouseRightButtonUp="OnTabRightClick"
                                        Tag="{Binding}">
                                    <TextBlock Text="{Binding Title}" Margin="11,5" FontSize="11"
                                               Foreground="{DynamicResource App.TextMuted}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="180" />
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter TargetName="TabHost" Property="Background"
                                                Value="{DynamicResource Tab.Active}" />
                                        <Setter TargetName="TabHost" Property="BorderBrush"
                                                Value="{DynamicResource Accent}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- ==================== Path header ==================== -->
            <Border Grid.Row="2" Padding="6,4" Background="{DynamicResource App.SurfaceAlt}"
                    BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="PathBox" Grid.Column="0" Style="{StaticResource SC.CommandLine}"
                             FontSize="11" Text="{Binding DisplayPath, Mode=OneWay}"
                             Foreground="{DynamicResource App.Text}"
                             KeyDown="OnPathKeyDown" GotKeyboardFocus="OnPathFocus" />

                    <Button Grid.Column="1" Style="{StaticResource SC.FlatButton}" Content="&#x21BB;"
                            FontSize="13" ToolTip="Re-read this folder (Ctrl+R)" Click="OnRefreshClick" />
                </Grid>
            </Border>

            <!-- ===================== File list ===================== -->
            <Grid Grid.Row="3">
                <ListView x:Name="List" Style="{StaticResource SC.FileList}"
                          ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                          AllowDrop="True"
                          GotKeyboardFocus="OnListGotFocus"
                          PreviewKeyDown="OnListPreviewKeyDown"
                          PreviewTextInput="OnListTextInput"
                          MouseDoubleClick="OnListDoubleClick"
                          PreviewMouseLeftButtonDown="OnListMouseLeftDown"
                          PreviewMouseMove="OnListMouseMove"
                          PreviewMouseRightButtonUp="OnListRightClick"
                          DragOver="OnListDragOver"
                          Drop="OnListDrop">
                    <ListView.View>
                        <GridView x:Name="Columns" ColumnHeaderContainerStyle="{StaticResource SC.ColumnHeader}"
                                  AllowsColumnReorder="False">
                            <GridViewColumn x:Name="ColName" Header="Name" Width="260">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="5,2">
                                            <Image Source="{Binding Icon}" Width="16" Height="16"
                                                   Margin="0,0,6,0" SnapsToDevicePixels="True"
                                                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                            <TextBlock Text="{Binding DisplayName}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn x:Name="ColExt" Header="Ext" Width="60">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Extension}" Margin="5,2"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn x:Name="ColSize" Header="Size" Width="92">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplaySize}" Margin="5,2"
                                                   HorizontalAlignment="Right" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn x:Name="ColDate" Header="Modified" Width="122">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayDate}" Margin="5,2" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn x:Name="ColAttr" Header="Attr" Width="62">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayAttributes}" Margin="5,2"
                                                   FontFamily="{DynamicResource Font.Mono}" FontSize="11" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- Error banner -->
                <Border VerticalAlignment="Top" Margin="10" Padding="12,8" CornerRadius="3"
                        Background="{DynamicResource App.SurfaceAlt}"
                        BorderBrush="{DynamicResource Status.Bad}" BorderThickness="1"
                        Visibility="{Binding ErrorText, Converter={StaticResource Conv.NullToVis}}">
                    <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" FontSize="11"
                               Foreground="{DynamicResource Status.Bad}" />
                </Border>

                <!-- Quick search overlay -->
                <Border x:Name="QuickSearchBadge" Visibility="Collapsed"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,12"
                        Padding="10,6" CornerRadius="4"
                        Background="{DynamicResource Accent}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Search:  " FontSize="11"
                                   Foreground="{DynamicResource Accent.Text}" />
                        <TextBlock x:Name="QuickSearchText" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Accent.Text}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ==================== Status line ==================== -->
            <Border Grid.Row="4" Padding="8,5" Background="{DynamicResource App.SurfaceAlt}"
                    BorderBrush="{DynamicResource App.Border}" BorderThickness="0,1,0,0">
                <Grid>
                    <TextBlock Style="{StaticResource SC.Label.Muted}" FontSize="11"
                               Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="FilterBadge" HorizontalAlignment="Right" FontSize="11"
                               Foreground="{DynamicResource Status.Warn}"
                               Visibility="{Binding QuickFilter, Converter={StaticResource Conv.NullToVis}}">
                        <Run Text="filter: " /><Run Text="{Binding QuickFilter, Mode=OneWay}" />
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
