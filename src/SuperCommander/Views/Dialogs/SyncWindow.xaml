<dlg:ThemedWindow x:Class="SuperCommander.Views.Dialogs.SyncWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:dlg="clr-namespace:SuperCommander.Views.Dialogs"
                  Title="Synchronize directories"
                  Width="1040" Height="680"
                  MinWidth="820" MinHeight="500"
                  WindowStartupLocation="CenterOwner">

    <dlg:ThemedWindow.Resources>
        <!-- The file list row, coloured by the decision instead of the file type. -->
        <Style x:Key="SyncRow" TargetType="ListViewItem">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
            <Setter Property="FontSize" Value="{DynamicResource Font.Size.Small}" />
            <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding RelativePath}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <GridViewRowPresenter VerticalAlignment="Center"
                                                  Columns="{TemplateBinding GridView.ColumnCollection}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Different">
                    <Setter Property="Foreground" Value="{DynamicResource Status.Warn}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Action}" Value="ToRight">
                    <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Action}" Value="ToLeft">
                    <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Action}" Value="DeleteLeft">
                    <Setter Property="Foreground" Value="{DynamicResource Status.Bad}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Action}" Value="DeleteRight">
                    <Setter Property="Foreground" Value="{DynamicResource Status.Bad}" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Row.Hover}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Accent.Subtle}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </dlg:ThemedWindow.Resources>

    <Grid Background="{DynamicResource App.Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- What to compare -->
        <Border Grid.Row="0" Background="{DynamicResource App.Surface}"
                BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,0,1"
                Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Style="{StaticResource SC.Label.Muted}" FontSize="11" Text="Left folder" />
                    <TextBox x:Name="LeftBox" Style="{StaticResource SC.TextBox}" Margin="0,3,0,0"
                             FontFamily="{DynamicResource Font.Mono}" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Style="{StaticResource SC.Label.Muted}" FontSize="11" Text="Right folder" />
                    <TextBox x:Name="RightBox" Style="{StaticResource SC.TextBox}" Margin="0,3,0,0"
                             FontFamily="{DynamicResource Font.Mono}" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="4" VerticalAlignment="Top">
                    <Button x:Name="CompareButton" Style="{StaticResource SC.Button.Primary}"
                            Content="Compare" MinWidth="110" Click="OnCompare" IsDefault="True" />
                    <Button x:Name="StopButton" Style="{StaticResource SC.Button}" Content="Stop"
                            Margin="0,8,0,0" IsEnabled="False" Click="OnStop" />
                </StackPanel>

                <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Style="{StaticResource SC.Label}" Text="File mask"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Grid.Column="1" x:Name="MaskBox" Style="{StaticResource SC.TextBox}" Text="*.*" />

                    <WrapPanel Grid.Column="2" Margin="18,0,0,0" VerticalAlignment="Center">
                        <CheckBox x:Name="SubfoldersCheck" Style="{StaticResource SC.CheckBox}"
                                  Content="Subfolders" IsChecked="True" Margin="0,0,16,0" />
                        <CheckBox x:Name="ContentCheck" Style="{StaticResource SC.CheckBox}"
                                  Content="By content" Margin="0,0,16,0"
                                  ToolTip="Read both files through before calling them equal." />
                        <CheckBox x:Name="IgnoreDateCheck" Style="{StaticResource SC.CheckBox}"
                                  Content="Ignore date" Margin="0,0,16,0"
                                  ToolTip="Compare on size alone, so a re-copied file is not treated as newer." />
                        <CheckBox x:Name="HiddenCheck" Style="{StaticResource SC.CheckBox}"
                                  Content="Hidden files" />
                    </WrapPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- What to show, and which way it goes -->
        <Border Grid.Row="1" Background="{DynamicResource App.SurfaceAlt}"
                BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,0,1"
                Padding="18,10">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource SC.Label.Muted}" FontSize="11" Text="SHOW"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ToggleButton x:Name="ShowLeftOnly" Style="{StaticResource SC.ToggleButton}"
                                  Content="Left only" IsChecked="True" Margin="0,0,6,0" Click="OnFilterChanged" />
                    <ToggleButton x:Name="ShowRightOnly" Style="{StaticResource SC.ToggleButton}"
                                  Content="Right only" IsChecked="True" Margin="0,0,6,0" Click="OnFilterChanged" />
                    <ToggleButton x:Name="ShowDiffering" Style="{StaticResource SC.ToggleButton}"
                                  Content="Differing" IsChecked="True" Margin="0,0,6,0" Click="OnFilterChanged" />
                    <ToggleButton x:Name="ShowEqual" Style="{StaticResource SC.ToggleButton}"
                                  Content="Equal" Margin="0,0,6,0" Click="OnFilterChanged" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Style="{StaticResource SC.Label.Muted}" FontSize="11" Text="SELECTED"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Style="{StaticResource SC.Button}" Content="Copy right" Margin="0,0,6,0"
                            Click="OnSetToRight" ToolTip="Send the selected rows to the right (Ctrl+Right)" />
                    <Button Style="{StaticResource SC.Button}" Content="Copy left" Margin="0,0,6,0"
                            Click="OnSetToLeft" ToolTip="Send the selected rows to the left (Ctrl+Left)" />
                    <Button Style="{StaticResource SC.Button}" Content="Skip" Margin="0,0,6,0"
                            Click="OnSetNone" ToolTip="Leave the selected rows alone (Space)" />
                    <Button Style="{StaticResource SC.Button}" Content="Delete" Margin="0,0,16,0"
                            Click="OnSetDelete" ToolTip="Delete the copy that has no partner (Delete)" />

                    <TextBlock Style="{StaticResource SC.Label.Muted}" FontSize="11" Text="ALL"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Style="{StaticResource SC.Button}" Content="Both ways" Margin="0,0,6,0"
                            Click="OnPresetBothWays" ToolTip="The newer file wins, in either direction" />
                    <Button Style="{StaticResource SC.Button}" Content="L to R" Margin="0,0,6,0"
                            Click="OnPresetLeftToRight" ToolTip="Make the right side match the left" />
                    <Button Style="{StaticResource SC.Button}" Content="R to L" Margin="0,0,6,0"
                            Click="OnPresetRightToLeft" ToolTip="Make the left side match the right" />
                    <Button Style="{StaticResource SC.Button}" Content="Mirror" Margin="0,0,6,0"
                            Click="OnPresetMirror"
                            ToolTip="Make the right an exact copy of the left, deleting what the left does not have" />
                    <Button Style="{StaticResource SC.Button}" Content="Nothing"
                            Click="OnPresetNothing" ToolTip="Clear every direction" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- The comparison -->
        <ListView Grid.Row="2" x:Name="EntryGrid"
                  Background="{DynamicResource App.Surface}"
                  Foreground="{DynamicResource App.Text}"
                  BorderThickness="0"
                  SelectionMode="Extended"
                  ItemContainerStyle="{StaticResource SyncRow}"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  MouseDoubleClick="OnRowActivated"
                  KeyDown="OnGridKeyDown">
            <ListView.View>
                <GridView ColumnHeaderContainerStyle="{StaticResource SC.ColumnHeader}">
                    <GridViewColumn Header="File" Width="360">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RelativePath}" Padding="8,3"
                                           FontFamily="{DynamicResource Font.Mono}"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Left size" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LeftSizeText}" Padding="8,3"
                                           HorizontalAlignment="Right" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Left modified" Width="130">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LeftDateText}" Padding="8,3" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="" Width="52">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Direction}" Padding="0,3"
                                           FontFamily="{DynamicResource Font.Mono}" FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Right size" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RightSizeText}" Padding="8,3"
                                           HorizontalAlignment="Right" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Right modified" Width="130">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RightDateText}" Padding="8,3" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Totals and the trigger -->
        <Border Grid.Row="3" Background="{DynamicResource App.SurfaceAlt}"
                BorderBrush="{DynamicResource App.Border}" BorderThickness="0,1,0,0"
                Padding="14,10">
            <Grid>
                <TextBlock x:Name="StatusText" Style="{StaticResource SC.Label.Muted}" FontSize="11"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SyncButton" Style="{StaticResource SC.Button.Primary}"
                            Content="Synchronize" MinWidth="120" Margin="0,0,10,0"
                            IsEnabled="False" Click="OnSynchronize" />
                    <Button Style="{StaticResource SC.Button}" Content="Close" IsCancel="True" Click="OnClose" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</dlg:ThemedWindow>
