<dlg:ThemedWindow x:Class="SuperCommander.Views.Dialogs.MessageDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:dlg="clr-namespace:SuperCommander.Views.Dialogs"
                  Title="SuperCommander"
                  SizeToContent="Height"
                  Width="470"
                  MinHeight="150"
                  ResizeMode="NoResize"
                  ShowInTaskbar="False"
                  WindowStartupLocation="CenterOwner">

    <Border Background="{DynamicResource App.Surface}"
            BorderBrush="{DynamicResource App.Border}" BorderThickness="1">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Message -->
            <Grid Grid.Row="0" Margin="22,22,22,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="IconHost" Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                        VerticalAlignment="Top" Margin="0,1,16,0"
                        Background="{DynamicResource Accent.Subtle}">
                    <Path x:Name="IconGlyph" Width="18" Height="18" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Fill="{DynamicResource Accent}" />
                </Border>

                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="HeadingText" Style="{StaticResource SC.Label}"
                               FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                               Margin="0,0,0,6" />
                    <TextBlock x:Name="MessageText" Style="{StaticResource SC.Label}"
                               TextWrapping="Wrap" LineHeight="18" VerticalAlignment="Top"
                               Foreground="{DynamicResource App.TextMuted}" />
                </StackPanel>
            </Grid>

            <!-- Optional technical details -->
            <StackPanel Grid.Row="1" x:Name="DetailsHost" Visibility="Collapsed" Margin="22,0,22,14">
                <ToggleButton x:Name="DetailsToggle" Style="{StaticResource SC.ToggleButton}"
                              HorizontalAlignment="Left" Content="Details"
                              Checked="OnDetailsToggled" Unchecked="OnDetailsToggled" />
                <Border x:Name="DetailsBox" Visibility="Collapsed" Margin="0,8,0,0"
                        Background="{DynamicResource App.SurfaceSunken}"
                        BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                        CornerRadius="3" MaxHeight="220">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                  Padding="10,8">
                        <TextBlock x:Name="DetailsText" FontFamily="{DynamicResource Font.Mono}"
                                   FontSize="11" Foreground="{DynamicResource App.TextMuted}"
                                   TextWrapping="NoWrap" />
                    </ScrollViewer>
                </Border>
            </StackPanel>

            <!-- Buttons -->
            <Border Grid.Row="2" Background="{DynamicResource App.SurfaceAlt}"
                    BorderBrush="{DynamicResource App.Border}" BorderThickness="0,1,0,0"
                    Padding="18,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Style="{StaticResource SC.Button}"
                            Content="Cancel" IsCancel="True" Visibility="Collapsed"
                            Margin="0,0,10,0" Click="OnCancel" />
                    <Button x:Name="OkButton" Style="{StaticResource SC.Button.Primary}"
                            Content="OK" IsDefault="True" Click="OnOk" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</dlg:ThemedWindow>
