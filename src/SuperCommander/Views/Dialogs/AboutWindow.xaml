<dlg:ThemedWindow x:Class="SuperCommander.Views.Dialogs.AboutWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:dlg="clr-namespace:SuperCommander.Views.Dialogs"
                  Title="About SuperCommander"
                  Width="700" Height="620"
                  MinWidth="560" MinHeight="440"
                  WindowStartupLocation="CenterOwner">

    <Grid Background="{DynamicResource App.Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource App.Surface}"
                BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,0,1"
                Padding="24,20">
            <StackPanel Orientation="Horizontal">
                <Border Width="46" Height="46" CornerRadius="10" Margin="0,0,16,0"
                        Background="{DynamicResource Accent}">
                    <TextBlock Text="SC" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource Accent.Text}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource SC.Label}" FontSize="17" FontWeight="SemiBold"
                               Text="SuperCommander" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource SC.Label.Muted}" FontSize="11" />
                    <TextBlock Style="{StaticResource SC.Label.Muted}" FontSize="11"
                               Text="Dual-pane orthodox file manager for Windows" />
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,18">
            <StackPanel x:Name="ShortcutHost" />
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource App.SurfaceAlt}"
                BorderBrush="{DynamicResource App.Border}" BorderThickness="0,1,0,0"
                Padding="18,14">
            <Button Style="{StaticResource SC.Button.Primary}" Content="Close"
                    HorizontalAlignment="Right" IsDefault="True" IsCancel="True" Click="OnClose" />
        </Border>
    </Grid>
</dlg:ThemedWindow>
