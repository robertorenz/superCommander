<dlg:ThemedWindow x:Class="SuperCommander.Views.Dialogs.ProgressDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:dlg="clr-namespace:SuperCommander.Views.Dialogs"
                  Title="Working"
                  Width="560"
                  SizeToContent="Height"
                  ResizeMode="NoResize"
                  ShowInTaskbar="False"
                  WindowStartupLocation="CenterOwner">

    <Border Background="{DynamicResource App.Surface}"
            BorderBrush="{DynamicResource App.Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="22,20,22,18">
                <TextBlock x:Name="CaptionText" Style="{StaticResource SC.Label}"
                           FontSize="14" FontWeight="SemiBold" Margin="0,0,0,14" />

                <TextBlock Style="{StaticResource SC.Label.Muted}" FontSize="11" Text="From" />
                <TextBlock x:Name="SourceText" Style="{StaticResource SC.Label}"
                           FontFamily="{DynamicResource Font.Mono}" FontSize="11"
                           TextTrimming="CharacterEllipsis" Margin="0,2,0,10" />

                <TextBlock Style="{StaticResource SC.Label.Muted}" FontSize="11" Text="To" />
                <TextBlock x:Name="TargetText" Style="{StaticResource SC.Label}"
                           FontFamily="{DynamicResource Font.Mono}" FontSize="11"
                           TextTrimming="CharacterEllipsis" Margin="0,2,0,16" />

                <Grid Margin="0,0,0,4">
                    <TextBlock Style="{StaticResource SC.Label.Muted}" FontSize="11" Text="Current file" />
                    <TextBlock x:Name="FilePercentText" Style="{StaticResource SC.Label.Muted}"
                               FontSize="11" HorizontalAlignment="Right" Text="0%" />
                </Grid>
                <ProgressBar x:Name="FileProgress" Style="{StaticResource SC.ProgressBar}"
                             Minimum="0" Maximum="100" Margin="0,0,0,14" />

                <Grid Margin="0,0,0,4">
                    <TextBlock Style="{StaticResource SC.Label.Muted}" FontSize="11" Text="Total" />
                    <TextBlock x:Name="TotalPercentText" Style="{StaticResource SC.Label.Muted}"
                               FontSize="11" HorizontalAlignment="Right" Text="0%" />
                </Grid>
                <ProgressBar x:Name="TotalProgress" Style="{StaticResource SC.ProgressBar}"
                             Minimum="0" Maximum="100" Margin="0,0,0,12" />

                <Grid>
                    <TextBlock x:Name="CountText" Style="{StaticResource SC.Label.Muted}" FontSize="11" />
                    <TextBlock x:Name="SpeedText" Style="{StaticResource SC.Label.Muted}"
                               FontSize="11" HorizontalAlignment="Right" />
                </Grid>
            </StackPanel>

            <Border Grid.Row="1" Background="{DynamicResource App.SurfaceAlt}"
                    BorderBrush="{DynamicResource App.Border}" BorderThickness="0,1,0,0"
                    Padding="18,14">
                <Button x:Name="CancelButton" Style="{StaticResource SC.Button}"
                        Content="Cancel" HorizontalAlignment="Right" IsCancel="True"
                        Click="OnCancel" />
            </Border>
        </Grid>
    </Border>
</dlg:ThemedWindow>
