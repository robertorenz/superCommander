<dlg:ThemedWindow x:Class="SuperCommander.Views.Dialogs.FtpConnectWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:dlg="clr-namespace:SuperCommander.Views.Dialogs"
                  Title="Connect to FTP server"
                  Width="820" Height="560"
                  MinWidth="700" MinHeight="480"
                  WindowStartupLocation="CenterOwner">

    <Grid Background="{DynamicResource App.Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================== Saved sites ===================== -->
        <Grid Grid.Row="0" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource SC.Label.Section}"
                       Text="SAVED SITES" Margin="16,16,16,8" />

            <ListBox Grid.Row="1" x:Name="SiteList" BorderThickness="0" Margin="8,0,8,0"
                     Background="Transparent"
                     SelectionChanged="OnSiteSelected"
                     MouseDoubleClick="OnConnect">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,7" />
                        <Setter Property="Margin" Value="0,0,0,2" />
                        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" CornerRadius="3" Background="Transparent"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{DynamicResource Row.Hover}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{DynamicResource Accent}" />
                                            <Setter Property="Foreground" Value="{DynamicResource Accent.Text}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Display}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Summary}" FontSize="10" Opacity="0.75"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="16,10,16,16">
                <Button Style="{StaticResource SC.Button}" Content="New" MinWidth="0"
                        Padding="14,4" Margin="0,0,8,0" Click="OnNewSite" />
                <Button Style="{StaticResource SC.Button}" Content="Delete" MinWidth="0"
                        Padding="14,4" Click="OnDeleteSite" />
            </StackPanel>
        </Grid>

        <Rectangle Grid.Row="0" Grid.Column="1" Width="1" Fill="{DynamicResource App.Border}" />

        <!-- ======================== Details ======================== -->
        <ScrollViewer Grid.Row="0" Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="20,16">
            <StackPanel x:Name="DetailPanel">
                <TextBlock Style="{StaticResource SC.Label.Section}" Text="CONNECTION" />

                <TextBlock Style="{StaticResource SC.Label.Muted}" FontSize="11" Text="Display name" />
                <TextBox x:Name="NameBox" Style="{StaticResource SC.TextBox}" Margin="0,3,0,10"
                         TextChanged="OnFieldChanged" />

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource SC.Label.Muted}" FontSize="11" Text="Host" />
                        <TextBox x:Name="HostBox" Style="{StaticResource SC.TextBox}" Margin="0,3,0,0"
                                 FontFamily="{DynamicResource Font.Mono}" TextChanged="OnFieldChanged" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource SC.Label.Muted}" FontSize="11" Text="Port" />
                        <TextBox x:Name="PortBox" Style="{StaticResource SC.TextBox}" Margin="0,3,0,0"
                                 FontFamily="{DynamicResource Font.Mono}" TextChanged="OnFieldChanged" />
                    </StackPanel>
                </Grid>

                <TextBlock Style="{StaticResource SC.Label.Muted}" FontSize="11" Text="Encryption" />
                <ComboBox x:Name="SecurityBox" Style="{StaticResource SC.ComboBox}" Margin="0,3,0,10"
                          SelectionChanged="OnSecurityChanged" />

                <CheckBox x:Name="AcceptCertCheck" Style="{StaticResource SC.CheckBox}"
                          Content="Accept self-signed or untrusted certificates"
                          Margin="0,0,0,14" Click="OnFieldChanged" />

                <TextBlock Style="{StaticResource SC.Label.Section}" Text="CREDENTIALS" />

                <CheckBox x:Name="AnonymousCheck" Style="{StaticResource SC.CheckBox}"
                          Content="Anonymous login" Margin="0,0,0,8" Click="OnAnonymousChanged" />

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource SC.Label.Muted}" FontSize="11" Text="User name" />
                        <TextBox x:Name="UserBox" Style="{StaticResource SC.TextBox}" Margin="0,3,0,0"
                                 TextChanged="OnFieldChanged" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource SC.Label.Muted}" FontSize="11" Text="Password" />
                        <PasswordBox x:Name="PasswordBox" Margin="0,3,0,0" Padding="6,4"
                                     Background="{DynamicResource Input.Background}"
                                     Foreground="{DynamicResource App.Text}"
                                     BorderBrush="{DynamicResource Input.Border}" BorderThickness="1"
                                     CaretBrush="{DynamicResource App.Text}"
                                     PasswordChanged="OnPasswordChanged" />
                    </StackPanel>
                </Grid>

                <CheckBox x:Name="SavePasswordCheck" Style="{StaticResource SC.CheckBox}"
                          Content="Remember password (encrypted for this Windows account)"
                          Margin="0,0,0,14" Click="OnFieldChanged" />

                <TextBlock Style="{StaticResource SC.Label.Section}" Text="START FOLDER" />
                <TextBox x:Name="PathBox" Style="{StaticResource SC.TextBox}"
                         FontFamily="{DynamicResource Font.Mono}" Text="/"
                         TextChanged="OnFieldChanged" />

                <TextBlock x:Name="StatusText" Style="{StaticResource SC.Label.Muted}"
                           FontSize="11" TextWrapping="Wrap" Margin="0,14,0,0" />
            </StackPanel>
        </ScrollViewer>

        <!-- ========================= Footer ========================= -->
        <Border Grid.Row="1" Grid.ColumnSpan="3" Background="{DynamicResource App.SurfaceAlt}"
                BorderBrush="{DynamicResource App.Border}" BorderThickness="0,1,0,0"
                Padding="18,14">
            <Grid>
                <TextBlock x:Name="HintText" Style="{StaticResource SC.Label.Muted}" FontSize="11"
                           VerticalAlignment="Center"
                           Text="Sites are saved automatically. Passwords never leave this machine in the clear." />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource SC.Button}" Content="Close"
                            IsCancel="True" Margin="0,0,10,0" Click="OnClose" />
                    <Button x:Name="ConnectButton" Style="{StaticResource SC.Button.Primary}"
                            Content="Connect" IsDefault="True" Click="OnConnect" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</dlg:ThemedWindow>
