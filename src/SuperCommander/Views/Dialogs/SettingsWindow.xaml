<dlg:ThemedWindow x:Class="SuperCommander.Views.Dialogs.SettingsWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:dlg="clr-namespace:SuperCommander.Views.Dialogs"
                  Title="Settings"
                  Width="620" Height="620"
                  MinWidth="520" MinHeight="480"
                  WindowStartupLocation="CenterOwner">

    <Grid Background="{DynamicResource App.Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="22,20">
            <StackPanel>
                <TextBlock Style="{StaticResource SC.Label.Section}" Text="APPEARANCE" />
                <StackPanel Margin="0,0,0,20">
                    <RadioButton x:Name="ThemeDark" Style="{StaticResource SC.RadioButton}"
                                 GroupName="Theme" Content="Dark slate" Checked="OnThemeChanged" />
                    <RadioButton x:Name="ThemeLight" Style="{StaticResource SC.RadioButton}"
                                 GroupName="Theme" Content="Classic light" Checked="OnThemeChanged" />
                    <CheckBox x:Name="ShowIcons" Style="{StaticResource SC.CheckBox}"
                              Content="Show file type icons" Margin="0,8,0,0" />
                </StackPanel>

                <TextBlock Style="{StaticResource SC.Label.Section}" Text="LAYOUT" />
                <StackPanel Margin="0,0,0,20">
                    <CheckBox x:Name="ShowDriveBar" Style="{StaticResource SC.CheckBox}" Content="Drive button bar" />
                    <CheckBox x:Name="ShowFunctionBar" Style="{StaticResource SC.CheckBox}" Content="Function key bar" />
                    <CheckBox x:Name="ShowCommandLine" Style="{StaticResource SC.CheckBox}" Content="Command line" />
                </StackPanel>

                <TextBlock Style="{StaticResource SC.Label.Section}" Text="FILE LIST" />
                <StackPanel Margin="0,0,0,20">
                    <CheckBox x:Name="ShowHidden" Style="{StaticResource SC.CheckBox}"
                              Content="Show hidden and system files" />
                    <CheckBox x:Name="DirectoriesFirst" Style="{StaticResource SC.CheckBox}"
                              Content="Sort folders before files" />
                </StackPanel>

                <TextBlock Style="{StaticResource SC.Label.Section}" Text="OPERATIONS" />
                <StackPanel Margin="0,0,0,20">
                    <CheckBox x:Name="ConfirmDelete" Style="{StaticResource SC.CheckBox}"
                              Content="Confirm before deleting" />
                    <CheckBox x:Name="UseRecycleBin" Style="{StaticResource SC.CheckBox}"
                              Content="Delete to the Recycle Bin" />
                </StackPanel>

                <TextBlock Style="{StaticResource SC.Label.Section}" Text="EXTERNAL TOOLS" />
                <StackPanel>
                    <TextBlock Style="{StaticResource SC.Label.Muted}" FontSize="11"
                               Text="Editor for F4 (blank uses Notepad)" />
                    <TextBox x:Name="EditorBox" Style="{StaticResource SC.TextBox}"
                             FontFamily="{DynamicResource Font.Mono}" Margin="0,3,0,10" />

                    <TextBlock Style="{StaticResource SC.Label.Muted}" FontSize="11"
                               Text="Viewer for Alt+F3 (blank uses the internal viewer)" />
                    <TextBox x:Name="ViewerBox" Style="{StaticResource SC.TextBox}"
                             FontFamily="{DynamicResource Font.Mono}" Margin="0,3,0,10" />

                    <TextBlock x:Name="SettingsPathText" Style="{StaticResource SC.Label.Muted}"
                               FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{DynamicResource App.SurfaceAlt}"
                BorderBrush="{DynamicResource App.Border}" BorderThickness="0,1,0,0"
                Padding="18,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SC.Button}" Content="Cancel"
                        IsCancel="True" Margin="0,0,10,0" Click="OnCancel" />
                <Button Style="{StaticResource SC.Button.Primary}" Content="Save"
                        IsDefault="True" Click="OnSave" />
            </StackPanel>
        </Border>
    </Grid>
</dlg:ThemedWindow>
