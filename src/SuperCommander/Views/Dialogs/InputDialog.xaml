<dlg:ThemedWindow x:Class="SuperCommander.Views.Dialogs.InputDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:dlg="clr-namespace:SuperCommander.Views.Dialogs"
                  Title="SuperCommander"
                  SizeToContent="Height"
                  Width="560"
                  ResizeMode="NoResize"
                  ShowInTaskbar="False"
                  WindowStartupLocation="CenterOwner">

    <Border Background="{DynamicResource App.Surface}"
            BorderBrush="{DynamicResource App.Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="22,20,22,18">
                <TextBlock x:Name="PromptText" Style="{StaticResource SC.Label}"
                           TextWrapping="Wrap" Margin="0,0,0,10" />

                <TextBox x:Name="InputBox" Style="{StaticResource SC.TextBox}"
                         FontFamily="{DynamicResource Font.Mono}"
                         KeyDown="OnInputKeyDown" />

                <TextBlock x:Name="HintText" Style="{StaticResource SC.Label.Muted}"
                           FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                           Visibility="Collapsed" />
            </StackPanel>

            <Border Grid.Row="1" Background="{DynamicResource App.SurfaceAlt}"
                    BorderBrush="{DynamicResource App.Border}" BorderThickness="0,1,0,0"
                    Padding="18,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource SC.Button}" Content="Cancel"
                            IsCancel="True" Margin="0,0,10,0" Click="OnCancel" />
                    <Button x:Name="OkButton" Style="{StaticResource SC.Button.Primary}"
                            Content="OK" IsDefault="True" Click="OnOk" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</dlg:ThemedWindow>
