<dlg:ThemedWindow x:Class="SuperCommander.Views.Dialogs.ViewerWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:dlg="clr-namespace:SuperCommander.Views.Dialogs"
                  Title="Viewer"
                  Width="980" Height="700"
                  MinWidth="480" MinHeight="320"
                  WindowStartupLocation="CenterOwner"
                  KeyDown="OnKeyDown">

    <Grid Background="{DynamicResource App.Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{DynamicResource App.SurfaceAlt}"
                BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,0,1"
                Padding="10,7">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <ToggleButton x:Name="TextMode" Style="{StaticResource SC.ToggleButton}"
                                  Content="Text  F3" Margin="0,0,4,0" Click="OnModeChanged" />
                    <ToggleButton x:Name="HexMode" Style="{StaticResource SC.ToggleButton}"
                                  Content="Hex  F4" Margin="0,0,4,0" Click="OnModeChanged" />
                    <ToggleButton x:Name="ImageMode" Style="{StaticResource SC.ToggleButton}"
                                  Content="Image  F5" Margin="0,0,12,0" Click="OnModeChanged" />

                    <TextBlock Style="{StaticResource SC.Label.Muted}" Text="Encoding" Margin="0,0,6,0" />
                    <ComboBox x:Name="EncodingBox" Style="{StaticResource SC.ComboBox}" Width="130"
                              SelectionChanged="OnEncodingChanged" />

                    <ToggleButton x:Name="WrapToggle" Style="{StaticResource SC.ToggleButton}"
                                  Content="Wrap" Margin="12,0,0,0" IsChecked="True" Click="OnWrapChanged" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBox x:Name="FindBox" Style="{StaticResource SC.TextBox}" Width="200"
                             Padding="6,3" KeyDown="OnFindKeyDown" />
                    <Button Style="{StaticResource SC.Button}" Content="Find  F7" MinWidth="0"
                            Padding="10,3" Margin="6,0,0,0" Click="OnFindNext" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1">
            <TextBox x:Name="TextView" Style="{StaticResource SC.TextBox.Mono}"
                     IsReadOnly="True" BorderThickness="0" Padding="12,10"
                     Background="{DynamicResource App.Surface}"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     TextWrapping="Wrap" AcceptsReturn="True" />

            <ScrollViewer x:Name="ImageScroller" Visibility="Collapsed"
                          Background="{DynamicResource App.SurfaceSunken}"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Image x:Name="ImageView" Stretch="None" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Margin="20" />
            </ScrollViewer>
        </Grid>

        <!-- Status -->
        <Border Grid.Row="2" Background="{DynamicResource App.SurfaceAlt}"
                BorderBrush="{DynamicResource App.Border}" BorderThickness="0,1,0,0"
                Padding="12,6">
            <Grid>
                <TextBlock x:Name="PathText" Style="{StaticResource SC.Label.Muted}"
                           FontSize="11" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="InfoText" Style="{StaticResource SC.Label.Muted}"
                           FontSize="11" HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</dlg:ThemedWindow>
