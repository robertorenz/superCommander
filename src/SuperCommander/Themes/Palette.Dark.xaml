<!--
    SuperCommander - Dark Slate palette.
    Every key here must also exist in Palette.Light.xaml so the two can be
    hot-swapped at runtime. Consumers must bind with DynamicResource.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Structure -->
    <SolidColorBrush x:Key="App.Background"      Color="#14171C" />
    <SolidColorBrush x:Key="App.Surface"         Color="#1E2228" />
    <SolidColorBrush x:Key="App.SurfaceAlt"      Color="#262B33" />
    <SolidColorBrush x:Key="App.SurfaceSunken"   Color="#101317" />
    <SolidColorBrush x:Key="App.Header"          Color="#1A1D23" />
    <SolidColorBrush x:Key="App.Border"          Color="#2E3440" />
    <SolidColorBrush x:Key="App.BorderStrong"    Color="#3B4351" />

    <!-- Type -->
    <SolidColorBrush x:Key="App.Text"            Color="#E6EAF0" />
    <SolidColorBrush x:Key="App.TextMuted"       Color="#9AA4B2" />
    <SolidColorBrush x:Key="App.TextDim"         Color="#6B7583" />
    <SolidColorBrush x:Key="App.TextInverse"     Color="#FFFFFF" />

    <!-- Accent (steel blue, deliberately not purple) -->
    <SolidColorBrush x:Key="Accent"              Color="#2F81F7" />
    <SolidColorBrush x:Key="Accent.Hover"        Color="#4C94F8" />
    <SolidColorBrush x:Key="Accent.Pressed"      Color="#1F6FE0" />
    <SolidColorBrush x:Key="Accent.Subtle"       Color="#1B2B41" />
    <SolidColorBrush x:Key="Accent.Text"         Color="#FFFFFF" />

    <!-- File list rows -->
    <SolidColorBrush x:Key="Row.Cursor"          Color="#2F81F7" />
    <SolidColorBrush x:Key="Row.CursorText"      Color="#FFFFFF" />
    <SolidColorBrush x:Key="Row.CursorInactive"  Color="#333A45" />
    <SolidColorBrush x:Key="Row.Hover"           Color="#232830" />
    <SolidColorBrush x:Key="Row.Alt"             Color="#191D23" />

    <!-- File classification -->
    <SolidColorBrush x:Key="File.Marked"         Color="#F0883E" />
    <SolidColorBrush x:Key="File.MarkedBg"       Color="#33261B" />
    <SolidColorBrush x:Key="File.Directory"      Color="#E6EAF0" />
    <SolidColorBrush x:Key="File.Parent"         Color="#9AA4B2" />
    <SolidColorBrush x:Key="File.Hidden"         Color="#6B7583" />
    <SolidColorBrush x:Key="File.Executable"     Color="#3FB950" />
    <SolidColorBrush x:Key="File.Archive"        Color="#D29922" />
    <SolidColorBrush x:Key="File.ReadOnly"       Color="#79C0FF" />

    <!-- Status -->
    <SolidColorBrush x:Key="Status.Good"         Color="#3FB950" />
    <SolidColorBrush x:Key="Status.Warn"         Color="#D29922" />
    <SolidColorBrush x:Key="Status.Bad"          Color="#F85149" />
    <SolidColorBrush x:Key="Status.Info"         Color="#58A6FF" />

    <!-- Chrome widgets -->
    <SolidColorBrush x:Key="Button.Background"   Color="#262B33" />
    <SolidColorBrush x:Key="Button.Hover"        Color="#313842" />
    <SolidColorBrush x:Key="Button.Pressed"      Color="#1B1F26" />
    <SolidColorBrush x:Key="Button.Border"       Color="#3B4351" />
    <SolidColorBrush x:Key="Input.Background"    Color="#101317" />
    <SolidColorBrush x:Key="Input.Border"        Color="#3B4351" />
    <SolidColorBrush x:Key="Menu.Background"     Color="#1E2228" />
    <SolidColorBrush x:Key="Menu.Hover"          Color="#2F81F7" />
    <SolidColorBrush x:Key="Menu.Separator"      Color="#2E3440" />
    <SolidColorBrush x:Key="Scroll.Track"        Color="#16191E" />
    <SolidColorBrush x:Key="Scroll.Thumb"        Color="#3B4351" />
    <SolidColorBrush x:Key="Scroll.ThumbHover"   Color="#4C5666" />
    <SolidColorBrush x:Key="Tab.Background"      Color="#1A1D23" />
    <SolidColorBrush x:Key="Tab.Active"          Color="#262B33" />
    <SolidColorBrush x:Key="Progress.Track"      Color="#101317" />
    <SolidColorBrush x:Key="Progress.Fill"       Color="#2F81F7" />
</ResourceDictionary>
