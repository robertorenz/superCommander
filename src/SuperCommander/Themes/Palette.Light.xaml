<!--
    SuperCommander - Classic Light palette (Total Commander heritage look).
    Key-for-key mirror of Palette.Dark.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Structure -->
    <SolidColorBrush x:Key="App.Background"      Color="#ECF0F4" />
    <SolidColorBrush x:Key="App.Surface"         Color="#FFFFFF" />
    <SolidColorBrush x:Key="App.SurfaceAlt"      Color="#E8EDF3" />
    <SolidColorBrush x:Key="App.SurfaceSunken"   Color="#FFFFFF" />
    <SolidColorBrush x:Key="App.Header"          Color="#DCE3EB" />
    <SolidColorBrush x:Key="App.Border"          Color="#C3CCD6" />
    <SolidColorBrush x:Key="App.BorderStrong"    Color="#A9B4C0" />

    <!-- Type -->
    <SolidColorBrush x:Key="App.Text"            Color="#101418" />
    <SolidColorBrush x:Key="App.TextMuted"       Color="#55606C" />
    <SolidColorBrush x:Key="App.TextDim"         Color="#7A8592" />
    <SolidColorBrush x:Key="App.TextInverse"     Color="#FFFFFF" />

    <!-- Accent (navy, deliberately not purple) -->
    <SolidColorBrush x:Key="Accent"              Color="#0A5FB4" />
    <SolidColorBrush x:Key="Accent.Hover"        Color="#1470CC" />
    <SolidColorBrush x:Key="Accent.Pressed"      Color="#084B8F" />
    <SolidColorBrush x:Key="Accent.Subtle"       Color="#DCEAF9" />
    <SolidColorBrush x:Key="Accent.Text"         Color="#FFFFFF" />

    <!-- File list rows -->
    <SolidColorBrush x:Key="Row.Cursor"          Color="#003C74" />
    <SolidColorBrush x:Key="Row.CursorText"      Color="#FFFFFF" />
    <SolidColorBrush x:Key="Row.CursorInactive"  Color="#A9B4C0" />
    <SolidColorBrush x:Key="Row.Hover"           Color="#EDF3FA" />
    <SolidColorBrush x:Key="Row.Alt"             Color="#F5F8FB" />

    <!-- File classification -->
    <SolidColorBrush x:Key="File.Marked"         Color="#C42B1C" />
    <SolidColorBrush x:Key="File.MarkedBg"       Color="#FBE7E5" />
    <SolidColorBrush x:Key="File.Directory"      Color="#101418" />
    <SolidColorBrush x:Key="File.Parent"         Color="#55606C" />
    <SolidColorBrush x:Key="File.Hidden"         Color="#98A2AE" />
    <SolidColorBrush x:Key="File.Executable"     Color="#0B7A3E" />
    <SolidColorBrush x:Key="File.Archive"        Color="#8A6100" />
    <SolidColorBrush x:Key="File.ReadOnly"       Color="#0A5FB4" />

    <!-- Status -->
    <SolidColorBrush x:Key="Status.Good"         Color="#107C41" />
    <SolidColorBrush x:Key="Status.Warn"         Color="#8A6100" />
    <SolidColorBrush x:Key="Status.Bad"          Color="#C42B1C" />
    <SolidColorBrush x:Key="Status.Info"         Color="#0A5FB4" />

    <!-- Chrome widgets -->
    <SolidColorBrush x:Key="Button.Background"   Color="#E8EDF3" />
    <SolidColorBrush x:Key="Button.Hover"        Color="#DCE6F2" />
    <SolidColorBrush x:Key="Button.Pressed"      Color="#C9D6E6" />
    <SolidColorBrush x:Key="Button.Border"       Color="#A9B4C0" />
    <SolidColorBrush x:Key="Input.Background"    Color="#FFFFFF" />
    <SolidColorBrush x:Key="Input.Border"        Color="#A9B4C0" />
    <SolidColorBrush x:Key="Menu.Background"     Color="#FFFFFF" />
    <SolidColorBrush x:Key="Menu.Hover"          Color="#0A5FB4" />
    <SolidColorBrush x:Key="Menu.Separator"      Color="#C3CCD6" />
    <SolidColorBrush x:Key="Scroll.Track"        Color="#EDF1F5" />
    <SolidColorBrush x:Key="Scroll.Thumb"        Color="#B7C1CD" />
    <SolidColorBrush x:Key="Scroll.ThumbHover"   Color="#96A3B2" />
    <SolidColorBrush x:Key="Tab.Background"      Color="#DCE3EB" />
    <SolidColorBrush x:Key="Tab.Active"          Color="#FFFFFF" />
    <SolidColorBrush x:Key="Progress.Track"      Color="#DCE3EB" />
    <SolidColorBrush x:Key="Progress.Fill"       Color="#0A5FB4" />
</ResourceDictionary>
